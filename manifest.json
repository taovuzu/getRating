{
  "manifest_version": 3,
  "name": "Get Rating",
  "version": "1.0",
  "description": "Fetches problem ratings without revealing tags to prevent spoiling.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/content.js"
      ],
      "matches": [
        "*://*.codeforces.com/problemset/problem/*",
        "*://*.codeforces.com/contest/*/problem/*"
      ]
    }
  ],
  "action": {
    "default_title": "Get Rating",
    "default_popup": "popup/popup.html",
    "default_icon": "images/icon-128.png"
  }
}